# Used by the home-page scan client. Leave this empty in git.
# Put a real value only in a local .env file, which is gitignored.
BROWSERLESS_API_KEY=

# Optional. Host only: no scheme and no token.
# Empty uses the default host production-sfo.browserless.io.
BROWSERLESS_HOST=

# Unused in this version. Names only, for later work. Do not put real values here.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# NEXT_PUBLIC_APP_ORIGIN=
