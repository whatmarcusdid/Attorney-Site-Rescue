# Used by the home-page scan client. Leave this empty in git.
# Put a real value only in a local .env file, which is gitignored.
BROWSERLESS_API_KEY=

# Optional. Host only: no scheme and no token.
# Empty uses the default host production-sfo.browserless.io.
BROWSERLESS_HOST=

# Transactional email. Leave the key and webhook secret empty in git.
RESEND_API_KEY=
RESEND_FROM_EMAIL=audit@attorneysiterescue.com
RESEND_WEBHOOK_SECRET=

# Server-only database client. Leave these empty in git. No schema in this version.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Unused until a browser or auth client exists. Do not put a real value here.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
